# https://editorconfig.org
# Editors read this file, so line endings and indentation stay consistent
# without anyone having to configure their IDE by hand.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# google-java-format, AOSP style, enforced by Spotless in "mvn verify".
[*.java]
indent_size = 4

# Maven's pom.xml is tab-indented.
[*.xml]
indent_style = tab

# Markdown uses trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false

# Windows scripts keep CRLF.
[*.{cmd,bat}]
end_of_line = crlf
