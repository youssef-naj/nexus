# A real deployment. Copy to .env.prod (git-ignored), fill in every value, then:
#   docker compose --env-file .env.prod -f compose.prod.yaml up -d --build --wait
# Generate a strong password in PowerShell with:
#   [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(24))
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=

# The public address people use, https in production. It is put into the links inside emails.
NEXUS_PUBLIC_BASE_URL=https://nexus.example.com
NEXUS_MAIL_FROM=Nexus <no-reply@example.com>

# Your SMTP provider
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true

# Secure cookies are the default. Leave this out.
# NEXUS_SECURE_COOKIES=true

# Loopback by default; put a TLS proxy in front (for example Caddy) and keep it that way
NEXUS_HTTP_PORT=8080
NEXUS_HTTP_BIND=127.0.0.1

NEXUS_PLATFORM_ADMIN_EMAILS=
