# Local demo of the production stack. Copy to .env.demo (git-ignored) and start with:
#   docker compose --env-file .env.demo -f compose.prod.yaml -f compose.demo.yaml up -d --build --wait
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=demo-password-not-for-production

NEXUS_PUBLIC_BASE_URL=http://localhost:8088
NEXUS_MAIL_FROM=nexus@localhost
NEXUS_HTTP_PORT=8088
NEXUS_HTTP_BIND=127.0.0.1
NEXUS_MAILPIT_PORT=8026

# Mailpit: no authentication, no TLS
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_AUTH=false

# The demo runs on plain http://localhost, where Secure cookies would not work in every browser.
# NEVER set this to false in a real deployment.
NEXUS_SECURE_COOKIES=false

# Comma-separated verified accounts that become platform administrators at startup
NEXUS_PLATFORM_ADMIN_EMAILS=
